<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:notatnik"
        mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="550"
        Width="850" Height="550"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        x:Class="notatnik.MainWindow"
        Title="Notatnik">

    <Grid ColumnDefinitions="300, 10, *" Margin="16">
        <!-- Lista zapisanych notatek -->
        <Border Grid.Column="0"
                BorderBrush="{DynamicResource CardStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12"
                Background="{DynamicResource CardBackgroundFillColorDefault}">
            <Grid RowDefinitions="Auto, *">
                <TextBlock Grid.Row="0"
                           Text="Zapisane notatki"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10" />

                <ListBox Grid.Row="1"
                         x:Name="NotesListBox"
                         SelectionMode="Single"
                         SelectionChanged="OnNotesListSelectionChanged"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="local:Note">
                            <Border Padding="6,4" Margin="0,2">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FormattedDate}"
                                               FontSize="11"
                                               Opacity="0.6" />
                                    <TextBlock Text="{Binding PreviewSnippet}"
                                               FontSize="12"
                                               Opacity="0.8"
                                               MaxLines="2"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Rozdzielacz -->
        <GridSplitter Grid.Column="1"
                      Width="4"
                      Background="Transparent"
                      ResizeDirection="Columns" />

        <!-- Formularz notatki -->
        <Border Grid.Column="2"
                BorderBrush="{DynamicResource CardStrokeColorDefault}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Background="{DynamicResource CardBackgroundFillColorDefault}">
            <Grid RowDefinitions="Auto, Auto, Auto, *, Auto">
                <!-- Pole na tytuł -->
                <TextBlock Grid.Row="0"
                           Text="Tytuł:"
                           FontWeight="Medium"
                           FontSize="13"
                           Margin="0,0,0,4" />
                <TextBox Grid.Row="1"
                         x:Name="TitleTextBox"
                         PlaceholderText="Wpisz tytuł notatki..."
                         FontSize="14"
                         Padding="10,8"
                         Margin="0,0,0,12" />

                <!-- Pole na treść -->
                <TextBlock Grid.Row="2"
                           Text="Treść:"
                           FontWeight="Medium"
                           FontSize="13"
                           Margin="0,0,0,4" />
                <TextBox Grid.Row="3"
                         x:Name="ContentTextBox"
                         PlaceholderText="Wpisz treść notatki..."
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalAlignment="Stretch"
                         FontSize="14"
                         Padding="10"
                         Margin="0,0,0,12" />

                <!-- Pasek zapisu -->
                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="SaveButton"
                            Content="Zapisz"
                            Classes="accent"
                            Padding="20,8"
                            FontWeight="SemiBold"
                            Click="OnSaveClick" />

                    <TextBlock x:Name="StatusTextBlock"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="Medium" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
